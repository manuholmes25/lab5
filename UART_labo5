import serial
from time import sleep

ser = serial.Serial('/dev/ttyACM0', 9600, timeout=1)
ser.reset_input_buffer()
sleep(2)

while True:
    raw = ser.readline()
    try:
        value = raw.decode('utf-8').rstrip()
        print(f"Datos decodificados: {value}")
    except UnicodeDecodeError:
        print(f"Bytes crudos: {raw}")
